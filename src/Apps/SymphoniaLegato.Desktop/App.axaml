<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SymphoniaLegato.Desktop"
             xmlns:conv="using:SymphoniaLegato.Desktop.Converters"
             x:Class="SymphoniaLegato.Desktop.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <conv:BoolToPlayPauseConverter x:Key="BoolToPlayPauseConverter"/>
    <conv:BoolToStartStopConverter x:Key="BoolToStartStopConverter"/>
    <conv:EnumEqualsConverter x:Key="EnumEquals"/>
  </Application.Resources>

  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://SymphoniaLegato.Desktop/Themes/SymphoniaTheme.axaml"/>
  </Application.Styles>
</Application>
