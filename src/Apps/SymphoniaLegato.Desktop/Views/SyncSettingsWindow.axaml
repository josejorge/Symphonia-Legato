<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SymphoniaLegato.Desktop.ViewModels"
        xmlns:ie="using:SymphoniaLegato.ImportExport"
        x:Class="SymphoniaLegato.Desktop.Views.SyncSettingsWindow"
        x:DataType="vm:SyncSettingsViewModel"
        Title="Cloud Sync"
        Width="540" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackground}"
        ShowInTaskbar="False">

  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- Sync folder picker -->
    <Border Grid.Row="0"
            Background="{DynamicResource ToolbarBackground}"
            BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}"
            Padding="12,10">
      <StackPanel Spacing="6">
        <TextBlock Text="Sync Folder (OneDrive / Dropbox / Nextcloud local path)"
                   FontSize="11" Foreground="{DynamicResource ForegroundDimColor}"/>
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox Grid.Column="0"
                   Text="{Binding SyncFolder}"
                   Watermark="Path to cloud-synced folder..."
                   AutomationProperties.Name="Sync folder path"
                   IsReadOnly="True" Margin="0,0,6,0"/>
          <Button Grid.Column="1"
                  Content="Browse..."
                  Command="{Binding BrowseSyncFolderCommand}"
                  Background="{DynamicResource CardBackground}"
                  CornerRadius="4" Padding="8,5" Margin="0,0,6,0"/>
          <Button Grid.Column="2"
                  Content="&#x21BA;"
                  Command="{Binding RefreshRemoteListCommand}"
                  ToolTip.Tip="Refresh list"
                  Classes="toolbar-btn"/>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Remote scores list -->
    <ListBox Grid.Row="1"
             ItemsSource="{Binding RemoteScores}"
             Background="Transparent"
             AutomationProperties.Name="Scores in sync folder">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="ie:SyncedScoreInfo">
          <Grid ColumnDefinitions="*,Auto,Auto" Margin="8,6">
            <StackPanel Grid.Column="0" Spacing="1">
              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" FontSize="12"
                         Foreground="{DynamicResource ForegroundColor}"/>
              <TextBlock Text="{Binding LastModified, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                         FontSize="10" Foreground="{DynamicResource ForegroundDimColor}"/>
            </StackPanel>
            <Button Grid.Column="2"
                    Content="&#x2B07; Pull"
                    Command="{Binding $parent[ListBox].((vm:SyncSettingsViewModel)DataContext).PullSelectedCommand}"
                    CommandParameter="{Binding}"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="4" Padding="8,4" FontSize="11"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Status -->
    <Border Grid.Row="2"
            Background="{DynamicResource PanelBackground}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"
            Padding="12,6">
      <TextBlock Text="{Binding StatusText}"
                 FontSize="11" Foreground="{DynamicResource ForegroundDimColor}"
                 TextTrimming="CharacterEllipsis"/>
    </Border>

    <!-- Buttons -->
    <Border Grid.Row="3"
            Background="{DynamicResource PanelBackground}"
            BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrush}"
            Padding="12,8">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <ProgressBar Grid.Column="0" IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Height="4" VerticalAlignment="Center" Margin="0,0,12,0"/>
        <Button Grid.Column="1"
                Content="&#x2B06; Push Current"
                Command="{Binding PushCurrentScoreCommand}"
                Margin="0,0,8,0"
                Background="{DynamicResource AccentColor}"
                Foreground="White" CornerRadius="4" Padding="10,6"/>
        <Button Grid.Column="2"
                Content="Close"
                Command="{Binding CloseCommand}"
                Background="{DynamicResource CardBackground}"
                CornerRadius="4" Padding="10,6"/>
      </Grid>
    </Border>

  </Grid>
</Window>
