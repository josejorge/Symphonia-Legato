<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SymphoniaLegato.Desktop.ViewModels"
             x:Class="SymphoniaLegato.Desktop.Views.MixerView"
             x:DataType="vm:MixerViewModel">

  <DockPanel>
    <TextBlock DockPanel.Dock="Top"
               Text="Mixer"
               FontSize="12" FontWeight="SemiBold"
               Margin="8,8,8,4"
               Foreground="{DynamicResource ForegroundColor}"/>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Channels}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MixerChannelViewModel">
            <Border Margin="4,2" Padding="6"
                    CornerRadius="4"
                    Background="{DynamicResource CardBackground}">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Name}"
                           FontSize="11" FontWeight="Medium"
                           Foreground="{DynamicResource ForegroundColor}"/>

                <!-- Volume -->
                <Grid ColumnDefinitions="36,*,30">
                  <TextBlock Grid.Column="0" Text="Vol" FontSize="10"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ForegroundDimColor}"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="127"
                          Value="{Binding Volume}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Volume}"
                             FontSize="10" TextAlignment="Right"
                             Foreground="{DynamicResource ForegroundDimColor}"
                             VerticalAlignment="Center"/>
                </Grid>

                <!-- Pan -->
                <Grid ColumnDefinitions="36,*,30">
                  <TextBlock Grid.Column="0" Text="Pan" FontSize="10"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource ForegroundDimColor}"/>
                  <Slider Grid.Column="1" Minimum="0" Maximum="127"
                          Value="{Binding Pan}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Pan}"
                             FontSize="10" TextAlignment="Right"
                             Foreground="{DynamicResource ForegroundDimColor}"
                             VerticalAlignment="Center"/>
                </Grid>

                <!-- Mute / Solo -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <ToggleButton IsChecked="{Binding IsMuted}"
                                Content="M" Width="28" Height="22"
                                FontSize="10"
                                ToolTip.Tip="Mute"/>
                  <ToggleButton IsChecked="{Binding IsSolo}"
                                Content="S" Width="28" Height="22"
                                FontSize="10"
                                ToolTip.Tip="Solo"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
