<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SymphoniaLegato.Desktop.ViewModels"
        xmlns:views="using:SymphoniaLegato.Desktop.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        x:Class="SymphoniaLegato.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource SurfaceBackground}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome">

  <Window.Styles>
    <Style Selector="MenuItem">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
  </Window.Styles>

  <DockPanel>

    <!-- Menu Bar -->
    <Menu DockPanel.Dock="Top" Background="{DynamicResource MenuBackground}">
      <MenuItem Header="_File">
        <MenuItem Header="_New Score"    Command="{Binding NewScoreCommand}"   InputGesture="Ctrl+N"/>
        <MenuItem Header="_Open..."      Command="{Binding OpenCommand}"       InputGesture="Ctrl+O"/>
        <Separator/>
        <MenuItem Header="_Save"         Command="{Binding SaveCommand}"       InputGesture="Ctrl+S"/>
        <MenuItem Header="Save _As..."   Command="{Binding SaveAsCommand}"     InputGesture="Ctrl+Shift+S"/>
        <Separator/>
        <MenuItem Header="E_xport">
          <MenuItem Header="MusicXML..." Command="{Binding ExportMusicXmlCommand}"
                    AutomationProperties.Name="Export MusicXML"/>
          <MenuItem Header="MIDI..."     Command="{Binding ExportMidiCommand}"/>
          <MenuItem Header="PDF..."      Command="{Binding ExportPdfCommand}"
                    AutomationProperties.Name="Export PDF"/>
          <MenuItem Header="PNG..."      Command="{Binding ExportPngCommand}"
                    AutomationProperties.Name="Export PNG image"/>
          <MenuItem Header="SVG..."      Command="{Binding ExportSvgCommand}"
                    AutomationProperties.Name="Export SVG vector"/>
        </MenuItem>
        <Separator/>
        <MenuItem Header="E_xit"         InputGesture="Alt+F4"/>
      </MenuItem>

      <MenuItem Header="_Edit">
        <MenuItem Header="_Undo"   Command="{Binding UndoCommand}"  InputGesture="Ctrl+Z"/>
        <MenuItem Header="_Redo"   Command="{Binding RedoCommand}"  InputGesture="Ctrl+Y"/>
        <Separator/>
        <MenuItem Header="Score _Properties..." Command="{Binding ShowScorePropertiesCommand}"
                  InputGesture="Ctrl+Shift+P"/>
      </MenuItem>

      <MenuItem Header="_View">
        <MenuItem Header="_Zoom In"    Command="{Binding ZoomInCommand}"    InputGesture="Ctrl+OemPlus"/>
        <MenuItem Header="Zoom _Out"   Command="{Binding ZoomOutCommand}"   InputGesture="Ctrl+OemMinus"/>
        <MenuItem Header="Zoom _Reset" Command="{Binding ZoomResetCommand}" InputGesture="Ctrl+D0"/>
        <Separator/>
        <MenuItem Header="Show _Mixer"          Command="{Binding ToggleMixerCommand}"/>
        <MenuItem Header="Show _Piano Keyboard" Command="{Binding TogglePianoKeyboardCommand}"/>
        <MenuItem Header="Show _Git History"    Command="{Binding ToggleGitHistoryCommand}"
                  InputGesture="Ctrl+Shift+G"/>
        <Separator/>
        <MenuItem Header="_High Contrast Theme" Command="{Binding ToggleHighContrastCommand}"
                  AutomationProperties.Name="Toggle high contrast theme"/>
      </MenuItem>

      <MenuItem Header="_Score">
        <MenuItem Header="Add _Measures"/>
        <MenuItem Header="Score _Properties..." Command="{Binding ShowScorePropertiesCommand}"/>
        <Separator/>
        <MenuItem Header="Key Signature..."/>
        <MenuItem Header="Time Signature..."/>
        <MenuItem Header="Clef..."/>
      </MenuItem>

      <MenuItem Header="_Playback">
        <MenuItem Header="_Play / Pause"   InputGesture="Space"/>
        <MenuItem Header="_Stop"           InputGesture="Escape"/>
        <MenuItem Header="_Loop"           InputGesture="Ctrl+L"/>
        <Separator/>
        <MenuItem Header="Metronome"/>
        <Separator/>
        <MenuItem Header="_MIDI / Audio Settings..." Command="{Binding ShowMidiSettingsCommand}"/>
      </MenuItem>

      <MenuItem Header="P_lugins">
        <MenuItem Header="_Plugin Manager..." Command="{Binding ShowPluginManagerCommand}"/>
      </MenuItem>

      <MenuItem Header="_Help">
        <MenuItem Header="_User Manual"/>
        <Separator/>
        <MenuItem Header="_About Symphonia Legato" Command="{Binding ShowAboutCommand}"/>
      </MenuItem>
    </Menu>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource ToolbarBackground}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource BorderBrush}"
            Height="44">
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,0">

        <!-- File ops -->
        <Button Command="{Binding NewScoreCommand}" ToolTip.Tip="New Score (Ctrl+N)"
                Classes="toolbar-btn" Content="&#x2B;"
                AutomationProperties.Name="New score"/>
        <Button Command="{Binding OpenCommand}"     ToolTip.Tip="Open (Ctrl+O)"
                Classes="toolbar-btn" Content="&#x1F4C2;"
                AutomationProperties.Name="Open score"/>
        <Button Command="{Binding SaveCommand}"     ToolTip.Tip="Save (Ctrl+S)"
                Classes="toolbar-btn" Content="&#x1F4BE;"
                AutomationProperties.Name="Save score"/>
        <Separator Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}"/>

        <!-- Undo/Redo -->
        <Button Command="{Binding UndoCommand}" ToolTip.Tip="Undo (Ctrl+Z)"
                Classes="toolbar-btn" Content="&#x21B6;"
                AutomationProperties.Name="Undo"/>
        <Button Command="{Binding RedoCommand}" ToolTip.Tip="Redo (Ctrl+Y)"
                Classes="toolbar-btn" Content="&#x21B7;"
                AutomationProperties.Name="Redo"/>
        <Separator Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}"/>

        <!-- Playback -->
        <views:PlaybackControlsView DataContext="{Binding PlaybackVm}"/>
        <Separator Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}"/>

        <!-- Zoom -->
        <Button Command="{Binding ZoomOutCommand}"   ToolTip.Tip="Zoom Out"
                Classes="toolbar-btn" Content="&#x2212;"
                AutomationProperties.Name="Zoom out"/>
        <TextBlock Text="{Binding Zoom, StringFormat='{}{0:P0}'}"
                   VerticalAlignment="Center" Width="50" TextAlignment="Center"
                   Foreground="{DynamicResource ForegroundColor}"
                   AutomationProperties.Name="Current zoom level"/>
        <Button Command="{Binding ZoomInCommand}"    ToolTip.Tip="Zoom In"
                Classes="toolbar-btn" Content="&#x2B;"
                AutomationProperties.Name="Zoom in"/>
        <Separator Width="1" Margin="4,6" Background="{DynamicResource BorderBrush}"/>

        <!-- View toggles -->
        <ToggleButton IsChecked="{Binding ShowPianoKeyboard}"
                      ToolTip.Tip="Toggle Piano Keyboard"
                      Classes="toolbar-btn" Content="&#x1F3B9;" Margin="0"
                      AutomationProperties.Name="Toggle piano keyboard"/>
        <ToggleButton IsChecked="{Binding ShowMixer}"
                      ToolTip.Tip="Toggle Mixer"
                      Classes="toolbar-btn" Content="&#x1F39A;" Margin="0"
                      AutomationProperties.Name="Toggle mixer"/>
        <ToggleButton IsChecked="{Binding ShowGitHistory}"
                      ToolTip.Tip="Toggle Git History"
                      Classes="toolbar-btn" Content="&#x23F3;" Margin="0"
                      AutomationProperties.Name="Toggle git history panel"/>
        <ToggleButton IsChecked="{Binding IsHighContrast}"
                      Command="{Binding ToggleHighContrastCommand}"
                      ToolTip.Tip="High Contrast Theme"
                      Classes="toolbar-btn" Content="&#x25D1;" Margin="0"
                      AutomationProperties.Name="Toggle high contrast theme"/>
      </StackPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBackground}"
            Height="24" Padding="8,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="11"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Grid.Column="1"
                   Text="{Binding ScoreEditor.SelectedMeasure, StringFormat='Measure: {0}'}"
                   VerticalAlignment="Center"
                   Foreground="White"
                   FontSize="11" Opacity="0.8"/>
      </Grid>
    </Border>

    <!-- Main content -->
    <Grid RowDefinitions="*,Auto,Auto">

      <!-- Score editor + optional right panels -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">

        <views:ScoreEditorView Grid.Column="0"
                               DataContext="{Binding ScoreEditor}"/>

        <!-- Git History panel -->
        <Border Grid.Column="1"
                IsVisible="{Binding ShowGitHistory}"
                Width="260"
                Background="{DynamicResource PanelBackground}"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource BorderBrush}">
          <views:GitHistoryView DataContext="{Binding GitHistory}"/>
        </Border>

        <!-- Mixer panel -->
        <Border Grid.Column="2"
                IsVisible="{Binding ShowMixer}"
                Width="220"
                Background="{DynamicResource PanelBackground}"
                BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource BorderBrush}">
          <views:MixerView DataContext="{Binding MixerVm}"/>
        </Border>
      </Grid>

      <!-- Note input toolbar -->
      <Border Grid.Row="1"
              Background="{DynamicResource ToolbarBackground}"
              BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderBrush}"
              Height="40">
        <views:NoteInputToolbarView DataContext="{Binding ScoreEditor}"/>
      </Border>

      <!-- Piano keyboard -->
      <Border Grid.Row="2"
              IsVisible="{Binding ShowPianoKeyboard}"
              Background="{DynamicResource PanelBackground}"
              BorderThickness="0,1,0,0"
              BorderBrush="{DynamicResource BorderBrush}"
              Height="120">
        <views:PianoKeyboardView DataContext="{Binding PianoKeyboard}"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
