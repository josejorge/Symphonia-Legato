<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SymphoniaLegato.Desktop.ViewModels"
             xmlns:controls="using:SymphoniaLegato.Rendering"
             x:Class="SymphoniaLegato.Desktop.Views.ScoreEditorView"
             x:DataType="vm:ScoreEditorViewModel"
             Background="{DynamicResource EditorBackground}">

  <Grid RowDefinitions="*">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource EditorBackground}">

      <controls:ScoreCanvas x:Name="ScoreCanvas"
                            LayoutResult="{Binding LayoutResult}"
                            Zoom="{Binding Zoom}"
                            SelectedNoteId="{Binding SelectedNoteId}"
                            ShowHandColoring="{Binding ShowHandColoring}"
                            NoteClicked="OnNoteClicked"
                            StaffPositionClicked="OnStaffPositionClicked"/>
    </ScrollViewer>
  </Grid>
</UserControl>
