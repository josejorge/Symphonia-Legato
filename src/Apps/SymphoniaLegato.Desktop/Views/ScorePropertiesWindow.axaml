<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SymphoniaLegato.Desktop.ViewModels"
        x:Class="SymphoniaLegato.Desktop.Views.ScorePropertiesWindow"
        x:DataType="vm:ScorePropertiesViewModel"
        Title="Score Properties"
        Width="520" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBackground}"
        ShowInTaskbar="False">

  <Grid RowDefinitions="*,Auto" Margin="0">

    <ScrollViewer Grid.Row="0" Padding="24,20,24,8">
      <StackPanel Spacing="14">

        <!-- Section: Metadata -->
        <TextBlock Text="Score Information"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentColor}"/>

        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Title:" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding Title}" AutomationProperties.Name="Score title"/>
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Subtitle:" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding Subtitle}"/>
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Composer:" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding Composer}"/>
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Lyricist:" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding Lyricist}"/>
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Arranger:" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding Arranger}"/>
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Copyright:" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding Copyright}"/>
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Notes:" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox   Grid.Column="1" Text="{Binding Notes}"
                       TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
          </Grid>
        </StackPanel>

        <!-- Section: Music settings -->
        <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,6"/>
        <TextBlock Text="Music Settings"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentColor}"/>

        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Tempo (BPM):" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding Tempo}"
                           Minimum="20" Maximum="400"
                           AutomationProperties.Name="Tempo in beats per minute"/>
          </Grid>
          <Grid ColumnDefinitions="130,*">
            <TextBlock Grid.Column="0" Text="Time Signature:" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <NumericUpDown Value="{Binding TimeNumerator}"   Minimum="1" Maximum="32" Width="90"/>
              <TextBlock Text="/" VerticalAlignment="Center" FontSize="16"/>
              <NumericUpDown Value="{Binding TimeDenominator}" Minimum="1" Maximum="64" Width="90"/>
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- Section: Page settings -->
        <Separator Background="{DynamicResource BorderBrush}" Height="1" Margin="0,6"/>
        <TextBlock Text="Page Settings"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentColor}"/>

        <Grid ColumnDefinitions="130,*">
          <TextBlock Grid.Column="0" Text="Page Size:" VerticalAlignment="Center"/>
          <ComboBox  Grid.Column="1"
                     ItemsSource="{x:Static vm:ScorePropertiesViewModel.PageSizeOptions}"
                     SelectedIndex="{Binding SelectedPageSizeIndex}"/>
        </Grid>

      </StackPanel>
    </ScrollViewer>

    <!-- Button row -->
    <Border Grid.Row="1"
            Background="{DynamicResource PanelBackground}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderBrush}"
            Padding="24,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">

        <TextBlock Grid.Column="0"
                   Text="* Unsaved changes"
                   IsVisible="{Binding IsModified}"
                   Foreground="{DynamicResource AccentColor}"
                   VerticalAlignment="Center" FontSize="11"/>

        <Button Grid.Column="1" Content="Apply"  Command="{Binding ApplyCommand}"
                Margin="0,0,8,0" Width="80" Background="{DynamicResource CardBackground}"
                CornerRadius="4"/>
        <Button Grid.Column="2" Content="OK"     Command="{Binding OkCommand}"
                Margin="0,0,8,0" Width="80"
                Background="{DynamicResource AccentColor}" Foreground="White" CornerRadius="4"/>
        <Button Grid.Column="3" Content="Cancel" Command="{Binding CancelCommand}"
                Width="80" Background="{DynamicResource CardBackground}" CornerRadius="4"/>
      </Grid>
    </Border>

  </Grid>
</Window>
