<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SymphoniaLegato.Desktop.ViewModels"
             x:Class="SymphoniaLegato.Desktop.Views.GitHistoryView"
             x:DataType="vm:GitHistoryViewModel">

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">

    <!-- Header -->
    <Border Grid.Row="0"
            Background="{DynamicResource ToolbarBackground}"
            BorderThickness="0,0,0,1"
            BorderBrush="{DynamicResource BorderBrush}"
            Padding="8,6">
      <StackPanel Spacing="4">
        <TextBlock Text="Git History"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource AccentColor}"
                   AutomationProperties.Name="Git History panel heading"/>
        <TextBlock Text="{Binding StatusText}"
                   FontSize="10" Foreground="{DynamicResource ForegroundDimColor}"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <!-- Commit list -->
    <ListBox Grid.Row="1"
             ItemsSource="{Binding History}"
             SelectedItem="{Binding SelectedCommit}"
             Background="Transparent"
             AutomationProperties.Name="Commit history list">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="4,4" Spacing="1">
            <TextBlock Text="{Binding Message}" FontSize="11" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource ForegroundColor}"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding Author}"
                         FontSize="10" Foreground="{DynamicResource ForegroundDimColor}"/>
              <TextBlock Grid.Column="1"
                         Text="{Binding Sha}"
                         FontSize="10" Foreground="{DynamicResource AccentColor}"
                         FontFamily="Cascadia Code, Consolas, monospace"/>
            </Grid>
            <TextBlock Text="{Binding When, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                       FontSize="10" Foreground="{DynamicResource ForegroundDimColor}"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Bottom panel: commit input -->
    <Border Grid.Row="2"
            Background="{DynamicResource PanelBackground}"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource BorderBrush}"
            Padding="8">
      <StackPanel Spacing="6">

        <TextBox Text="{Binding CommitMessage}"
                 Watermark="Commit message..."
                 AcceptsReturn="False"
                 AutomationProperties.Name="Commit message"
                 IsEnabled="{Binding IsInitialized}"/>

        <Grid ColumnDefinitions="*,32,Auto">
          <Button Grid.Column="0"
                  Content="&#x2714; Commit"
                  Command="{Binding CommitCommand}"
                  IsEnabled="{Binding IsInitialized}"
                  Background="{DynamicResource AccentColor}"
                  Foreground="White" CornerRadius="4" FontSize="11"/>
          <Button Grid.Column="1"
                  Content="&#x21BA;"
                  Command="{Binding RefreshCommand}"
                  ToolTip.Tip="Refresh history"
                  Classes="toolbar-btn" FontSize="13"/>
          <Button Grid.Column="2"
                  Content="&#x21A9; Restore"
                  Command="{Binding RestoreCommand}"
                  IsEnabled="{Binding SelectedCommit, Converter={x:Static ObjectConverters.IsNotNull}}"
                  Background="{DynamicResource CardBackground}"
                  Foreground="{DynamicResource ForegroundColor}"
                  CornerRadius="4" FontSize="11" Padding="6,4"/>
        </Grid>

      </StackPanel>
    </Border>

  </Grid>
</UserControl>
