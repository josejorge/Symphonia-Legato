<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SymphoniaLegato.Android</RootNamespace>
    <AssemblyName>SymphoniaLegato.Android</AssemblyName>
    <ApplicationId>com.josejorgehz.symphonialegato</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <AndroidManifest>Properties\AndroidManifest.xml</AndroidManifest>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Workaround for Avalonia.Android 11.2.x + Android SDK 35 (XAPRAS7023):
         Avalonia.Android computes an intermediate assembly staging path that the
         Android SDK's ProcessAssemblies task then doubles (Avalonia/Avalonia/).
         Pre-creating the directory and symlinking the DLL unblocks the build.
         Fixed in Avalonia 11.3.x — remove this block when upgrading. -->
    <AndroidUseAssemblyStore>false</AndroidUseAssemblyStore>

    <!--
      BUILD REQUIREMENT:
      Run once before building: dotnet workload install android
      Optionally also: dotnet workload install android-aot  (for AOT/release builds)
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\SymphoniaLegato.Core\SymphoniaLegato.Core.csproj" />
    <ProjectReference Include="..\..\Core\SymphoniaLegato.NotationEngine\SymphoniaLegato.NotationEngine.csproj" />
    <ProjectReference Include="..\..\Core\SymphoniaLegato.PlaybackEngine\SymphoniaLegato.PlaybackEngine.csproj" />
    <ProjectReference Include="..\..\Core\SymphoniaLegato.LayoutEngine\SymphoniaLegato.LayoutEngine.csproj" />
    <ProjectReference Include="..\..\Core\SymphoniaLegato.ImportExport\SymphoniaLegato.ImportExport.csproj" />
    <ProjectReference Include="..\..\Core\SymphoniaLegato.Rendering\SymphoniaLegato.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.3" />
    <PackageReference Include="Avalonia.Android" Version="11.2.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
  </ItemGroup>
  <!-- Workaround target: pre-create the doubled Avalonia path that ProcessAssemblies
       looks for due to the Avalonia.Android 11.2.x / Android SDK 35 path bug. -->
  <Target Name="FixAvaloniaAndroidDoubledPath"
          AfterTargets="CoreCompile"
          BeforeTargets="ProcessAssemblies">
    <MakeDir Directories="$(IntermediateOutputPath)Avalonia\Avalonia" Condition="Exists('$(IntermediateOutputPath)Avalonia')"/>
    <Copy SourceFiles="$(IntermediateOutputPath)Avalonia\$(AssemblyName).dll"
          DestinationFolder="$(IntermediateOutputPath)Avalonia\Avalonia"
          Condition="Exists('$(IntermediateOutputPath)Avalonia\$(AssemblyName).dll')"
          SkipUnchangedFiles="true"/>
    <Copy SourceFiles="$(IntermediateOutputPath)Avalonia\$(AssemblyName).pdb"
          DestinationFolder="$(IntermediateOutputPath)Avalonia\Avalonia"
          Condition="Exists('$(IntermediateOutputPath)Avalonia\$(AssemblyName).pdb')"
          SkipUnchangedFiles="true"/>
  </Target>
</Project>
