<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SymphoniaLegato.Android"
             x:Class="SymphoniaLegato.Android.App"
             RequestedThemeVariant="Dark">

  <Application.DataTemplates>
    <local:ViewLocator/>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://SymphoniaLegato.Android/Themes/MobileTheme.axaml"/>
  </Application.Styles>
</Application>
