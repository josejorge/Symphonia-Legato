<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Touch-optimised dark palette matching Desktop dark theme -->
  <Style>
    <Style.Resources>
      <SolidColorBrush x:Key="SurfaceBackground"  Color="#1E1E1E"/>
      <SolidColorBrush x:Key="PanelBackground"    Color="#2D2D2D"/>
      <SolidColorBrush x:Key="ToolbarBackground"  Color="#333333"/>
      <SolidColorBrush x:Key="CardBackground"     Color="#3A3A3A"/>
      <SolidColorBrush x:Key="ForegroundColor"    Color="#D4D4D4"/>
      <SolidColorBrush x:Key="ForegroundDimColor" Color="#858585"/>
      <SolidColorBrush x:Key="AccentColor"        Color="#007ACC"/>
      <SolidColorBrush x:Key="BorderBrush"        Color="#464646"/>
    </Style.Resources>
  </Style>

  <!-- Larger touch targets for mobile -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="48"/>
    <Setter Property="Padding"   Value="16,12"/>
    <Setter Property="FontSize"  Value="15"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource ForegroundColor}"/>
  </Style>

  <!-- Tab bar style -->
  <Style Selector="TabItem">
    <Setter Property="FontSize"  Value="14"/>
    <Setter Property="Padding"   Value="20,12"/>
    <Setter Property="Foreground" Value="{DynamicResource ForegroundDimColor}"/>
  </Style>
  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
  </Style>

</Styles>
